{
  "name": "dot-rosen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "data:build": "node tools/run.mjs tools/build-stations.ts",
    "font:build": "node tools/run.mjs tools/build-font.ts",
    "og:build": "node tools/run.mjs tools/og-image.ts",
    "icon:build": "node tools/run.mjs tools/icon-image.ts",
    "sprites:sheet": "node tools/run.mjs tools/sprites-sheet.ts",
    "parts:audit": "node tools/run.mjs tools/parts-audit.ts",
    "sprites:bench": "node tools/run.mjs tools/bench-sprites.ts",
    "card:sheet": "node tools/run.mjs tools/card-sheet.ts",
    "card:bench": "node tools/run.mjs tools/bench-card.ts",
    "print:bench": "node tools/run.mjs tools/bench-print.ts",
    "printer:fake": "node tools/run.mjs tools/fake-printer.ts",
    "raster:png": "node tools/run.mjs tools/raster-to-png.ts",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.13.19",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "opentype.js": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wawoff2": "2.0.1",
    "wrangler": "4.165.0",
    "esbuild": "0.28.2"
  }
}
