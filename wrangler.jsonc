// Cloudflare Worker の設定。画面（静的ファイル）と API を1つの Worker で公開する。
// 秘密の値（ADMIN_PASSWORD、PRINTER_TOKEN、SESSION_SECRET）はここに書かない。
// 本番は `wrangler secret put`、ローカルは .dev.vars（.dev.vars.example を写して作る）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dot-rosen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // 公開先。独自ドメインが正で、workers.dev の URL（dot-rosen.na2kera.workers.dev）も残す
  "routes": [{ "pattern": "dot-rosen.na2kera.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    // Worker から静的ファイルを読む（路線のページへの題と絵の差し込み）
    "binding": "ASSETS",
    // 見つからないパスは index.html を返す（SPA）
    "not_found_handling": "single-page-application",
    // /api/*・/r/*（路線のページ）・/og/*（X 用の絵）は静的ファイルより先に Worker が処理する
    "run_worker_first": ["/api/*", "/r/*", "/og/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dot-rosen",
      // 本番の D1 を作ったら `wrangler d1 create dot-rosen` で出た ID をここに入れる。
      // 空のままでもローカル開発（.wrangler/ 内のローカル D1）は動く。
      "database_id": "a3dbe770-090f-4907-8e08-1a88392fba50",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 路線カードの模様セット: "light" | "bold"
    "CARD_MONO_SET": "bold",
    // 路線カードの側面の置き方: "two-x1" | "lead-x2" | "two-x2-rotated"
    "CARD_SIDE_LAYOUT": "two-x1"
  },
  // 1日1回の掃除（古い印刷記録、古い回数制限。路線は消さない）。UTC 18:00 = 日本時間 3:00
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true }
}
